{
  "info": {
    "name": "Akatsuki's Draft API",
    "_postman_id": "akatsuki-draft-collection-v1",
    "description": "Complete API collection for Akatsuki's Draft — AI-Enabled Content Sharing Platform.\n\nSetup:\n1. Set the `baseUrl` variable to your server URL (default: http://localhost:5000)\n2. After login/register, copy the `token` from the response and set it in the `token` collection variable.\n3. All protected requests use `{{token}}` in the Authorization header automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token",   "value": "" },
    { "key": "postId",  "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Has token', () => pm.expect(body.token).to.be.a('string'));",
              "pm.test('No password in response', () => pm.expect(JSON.stringify(body)).to.not.include('password'));",
              "pm.collectionVariables.set('token', body.token);"
            ]}
          }]
        },
        {
          "name": "Register — duplicate email (negative)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 409 on duplicate email', () => pm.response.to.have.status(409));"
          ]}}]
        },
        {
          "name": "Register — validation error (negative)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-an-email\",\n  \"password\": \"123\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400 on invalid data', () => pm.response.to.have.status(400));",
            "pm.test('Returns errors array', () => pm.expect(pm.response.json().errors).to.be.an('array'));"
          ]}}]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('Has token', () => pm.expect(body.token).to.be.a('string'));",
            "pm.collectionVariables.set('token', body.token);"
          ]}}]
        },
        {
          "name": "Login — wrong password (negative)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"wrongpassword\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 401 on bad credentials', () => pm.response.to.have.status(401));"
          ]}}]
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth","me"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('No password', () => pm.expect(JSON.stringify(pm.response.json())).to.not.include('password'));"
          ]}}]
        },
        {
          "name": "Get Me — no token (negative)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth","me"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 401 without token', () => pm.response.to.have.status(401));"
          ]}}]
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create Post (draft)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/posts", "host": ["{{baseUrl}}"], "path": ["posts"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My First Blog Post\",\n  \"description\": \"A short description of the post\",\n  \"content\": \"This is the full content of the blog post. It has a lot of great information.\",\n  \"category\": \"Technology\",\n  \"status\": \"draft\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "pm.collectionVariables.set('postId', body.post._id);",
            "pm.test('Status is draft', () => pm.expect(body.post.status).to.equal('draft'));"
          ]}}]
        },
        {
          "name": "Create Post (pending)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/posts", "host": ["{{baseUrl}}"], "path": ["posts"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Submit for Review\",\n  \"description\": \"I want this reviewed\",\n  \"content\": \"Full content here for admin review.\",\n  \"category\": \"Science\",\n  \"status\": \"pending\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));"
          ]}}]
        },
        {
          "name": "Create Post — no auth (negative)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/posts", "host": ["{{baseUrl}}"], "path": ["posts"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Should Fail\",\n  \"description\": \"desc\",\n  \"content\": \"content\",\n  \"category\": \"Tech\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 401 without auth', () => pm.response.to.have.status(401));"
          ]}}]
        },
        {
          "name": "Get Approved Posts (public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/posts", "host": ["{{baseUrl}}"], "path": ["posts"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('All posts approved', () => {",
            "  pm.response.json().posts.forEach(p => pm.expect(p.status).to.equal('approved'));",
            "});"
          ]}}]
        },
        {
          "name": "Get Approved Post by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/posts/{{postId}}", "host": ["{{baseUrl}}"], "path": ["posts","{{postId}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200 or 404', () => {",
            "  pm.expect([200,404]).to.include(pm.response.code);",
            "});"
          ]}}]
        },
        {
          "name": "Get My Posts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/posts/my-posts", "host": ["{{baseUrl}}"], "path": ["posts","my-posts"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}]
        },
        {
          "name": "Update My Post",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/posts/{{postId}}", "host": ["{{baseUrl}}"], "path": ["posts","{{postId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Title\",\n  \"status\": \"pending\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}]
        },
        {
          "name": "Delete My Post",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/posts/{{postId}}", "host": ["{{baseUrl}}"], "path": ["posts","{{postId}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}]
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "⚠️  Set admin token first (manually paste admin JWT into {{token}})",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }
          }
        },
        {
          "name": "Get Pending Posts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/admin/posts/pending", "host": ["{{baseUrl}}"], "path": ["admin","posts","pending"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200 or 403', () => pm.expect([200,403]).to.include(pm.response.code));"
          ]}}]
        },
        {
          "name": "Get Pending Posts — non-admin (negative)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/admin/posts/pending", "host": ["{{baseUrl}}"], "path": ["admin","posts","pending"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 403 for regular user', () => pm.response.to.have.status(403));"
          ]}}]
        },
        {
          "name": "Approve Post",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/admin/posts/approve/{{postId}}", "host": ["{{baseUrl}}"], "path": ["admin","posts","approve","{{postId}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Status is approved', () => pm.expect(pm.response.json().post.status).to.equal('approved'));"
          ]}}]
        },
        {
          "name": "Reject Post",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/admin/posts/reject/{{postId}}", "host": ["{{baseUrl}}"], "path": ["admin","posts","reject","{{postId}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Status is rejected', () => pm.expect(pm.response.json().post.status).to.equal('rejected'));"
          ]}}]
        }
      ]
    },
    {
      "name": "AI",
      "item": [
        {
          "name": "Improve Post with Gemini",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/ai/improve/{{postId}}", "host": ["{{baseUrl}}"], "path": ["ai","improve","{{postId}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "pm.test('New draft created', () => pm.expect(body.newDraft.status).to.equal('draft'));",
            "pm.test('Original post ID preserved', () => pm.expect(body.originalPostId).to.be.a('string'));",
            "pm.test('New draft has different ID', () => pm.expect(body.newDraft._id).to.not.equal(body.originalPostId));"
          ]}}]
        },
        {
          "name": "Improve Post — no auth (negative)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/ai/improve/{{postId}}", "host": ["{{baseUrl}}"], "path": ["ai","improve","{{postId}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 401', () => pm.response.to.have.status(401));"
          ]}}]
        }
      ]
    }
  ]
}
