# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/akatsuki-draft?retryWrites=true&w=majority

# JWT secret — use a long random string (e.g. openssl rand -hex 64)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Google Gemini API key  (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Server port (Vercel ignores this; it is only used locally)
PORT=5000

# One-time admin promotion secret (keep this private)
ADMIN_PROMOTE_SECRET=your_admin_promote_secret_here
